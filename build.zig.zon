.{
    .name = .qmsg,
    .version = "0.7.0",
    .fingerprint = 0x650c9e5831497a83,
    .minimum_zig_version = "0.17.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "DESIGN.md",
        "WIRE.md",
        "AUTH.md",
        "ROADMAP.md",
    },
    .dependencies = .{
        .paseto = .{
            .url = "https://github.com/nullstyle/paseto-zig/archive/refs/tags/0.4.0.tar.gz",
            .hash = "paseto-0.4.0-EBI95RcXCADs0jz3tebS1xMaAiT2r3Tpx8HsF5LfpqOS",
        },
        // v0.24.0 (tag at 1d34b32): no lifetime stream cap. The stream
        // limit is a window of streams open at once, and an id comes back
        // only when its stream is closed in both directions, so qmsg opens
        // local streams in id order, waits on StreamLimitExceeded, and
        // closes every stream it opens or accepts. Its floor is the tagged
        // Zig 0.17.0. Same pin (and option map, see build.zig) as nest and
        // qmesh-zig, so a binary that links all three has one quic module.
        .quic = .{
            .url = "https://github.com/nullstyle/quic-zig/archive/refs/tags/v0.24.0.tar.gz",
            .hash = "quic-0.24.0-DnSYvUNHNABoGpnSvxo5VEF7RVsZTxddSW3UGp1vCrPw",
        },
        // Optional Cap'n Proto body codec dependency (`-Dcapnp=true`).
        // LAZY: default builds and non-opting consumers never fetch or
        // compile capnp-zig. Same tarball hash the release validation
        // recorded (github.com/nullstyle/capnp-zig/releases/tag/v0.17.0).
        .capnp = .{
            .url = "https://github.com/nullstyle/capnp-zig/archive/refs/tags/v0.17.0.tar.gz",
            .hash = "capnpc_zig-0.17.0-nUduFZYwNwDznNpR3qy-IV_-gehdwsAEFNJtMHTYxVJx",
            .lazy = true,
        },
    },
}
